{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 名前は firmwatch。同じアカウントにある別のシステム（sw-ars など）の Worker・ドメインには触れない
  "name": "firmwatch",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "firmwatch", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": {
    "RP_NAME": "FIRMWATCH",
    "GITHUB_REPOSITORY": "kajisho5/firmwatch"
  },
  "observability": { "enabled": true }
}
